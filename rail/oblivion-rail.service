[Unit]
Description=Oblivion Signal telemetry rail (Quickshell side panel)
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Run only while oblivion-signal is the active theme; re-evaluated on every
# restart, so a theme switch leaves the rail down even though Restart=always.
ExecCondition=/bin/sh -c 'test "$(cat %h/.local/state/omarchy/current/theme.name 2>/dev/null)" = oblivion-signal'
# start.sh execs quickshell, or — if a foreign instance owns the rail —
# waits it out and takes over so the panel ends up supervised either way.
ExecStart=%h/.config/omarchy/themes/oblivion-signal/rail/start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
